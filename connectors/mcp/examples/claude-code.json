{
  "mcpServers": {
    "relay-audit": {
      "type": "stdio",
      "command": "/absolute/path/to/connector-venv/bin/python",
      "args": [
        "-m",
        "api_relay_audit_mcp",
        "--config",
        "/absolute/path/to/private/connector.json"
      ],
      "env": {
        "API_RELAY_AUDIT_RELAY_KEY": "${API_RELAY_AUDIT_RELAY_KEY}"
      }
    }
  }
}
